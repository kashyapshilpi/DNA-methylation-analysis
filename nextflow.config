manifest {
    name            = 'kashyapshilpi/DNA-methylation-analysis'
    author          = 'Shilpi Kumari'
    homePage        = 'https://github.com/kashyapshilpi/DNA-methylation-analysis'
    description     = 'Bisulfite-seq DNA methylation: Bismark alignment and methylKit differential methylation'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '2.0.0'
}

params {
    // Inputs
    input              = null      // CSV: sample,fastq_1,fastq_2,condition (fastq_2 empty for single-end)
    fasta              = null      // reference genome FASTA
    outdir             = 'results'

    // Trimming
    adapters_pe        = "${projectDir}/assets/adapters/TruSeq3-PE.fa"
    adapters_se        = "${projectDir}/assets/adapters/TruSeq3-SE.fa"
    min_len            = 36

    // Bismark
    non_directional    = false     // set for non-directional / PBAT-like libraries
    bismark_parallel   = 1         // Bismark instances per sample (each uses several cores)

    // methylKit
    contrast_reference = 'control'
    contrast_target    = 'treatment'
    assembly           = 'genome'  // label stored in methylKit objects
    min_cov            = 10        // minimum reads per CpG
    diff_cutoff        = 25        // minimum % methylation difference
    qvalue             = 0.01
    tile_size          = 1000      // DMR window size (bp)
    genes_bed          = null      // optional 12-column transcript BED for annotation
    cpg_bed            = null      // optional CpG-island BED for annotation
}

process {
    cpus   = 2
    memory = 4.GB
    time   = 8.h

    withLabel: process_low    { cpus = 2; memory = 4.GB  }
    withLabel: process_medium { cpus = 4; memory = 8.GB  }
    withLabel: process_high   { cpus = 8; memory = 32.GB }

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: 'copy'
    ]

    // methylKit writes its own methylkit/ folder
    withName: 'METHYLKIT' {
        publishDir = [path: { params.outdir }, mode: 'copy']
    }
}

profiles {
    conda {
        conda.enabled  = true
        conda.channels = ['conda-forge', 'bioconda']
    }
    mamba {
        conda.enabled  = true
        conda.useMamba = true
        conda.channels = ['conda-forge', 'bioconda']
    }
    docker {
        // Containers are built on the fly from each process's conda packages by Wave
        docker.enabled = true
        wave.enabled   = true
        wave.strategy  = ['conda']
    }
    test {
        includeConfig 'conf/test.config'
    }
}

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }
