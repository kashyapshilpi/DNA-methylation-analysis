/*
 * Small public bisulfite-seq test dataset (nf-core/test-datasets, methylseq branch):
 *   nextflow run . -profile test,conda
 * Three single-end samples split 2 vs 1, low coverage thresholds so the toy genome yields CpGs.
 */
params {
    input     = "${projectDir}/assets/samplesheet_test.csv"
    fasta     = 'https://raw.githubusercontent.com/nf-core/test-datasets/methylseq/reference/genome.fa'
    min_cov   = 3
    tile_size = 500
}

process {
    resourceLimits = [cpus: 2, memory: 6.GB, time: 1.h]
}
